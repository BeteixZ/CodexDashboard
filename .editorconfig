root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,js,mjs,html,css,xaml,csproj,props,targets}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.ps1]
charset = utf-8-bom
end_of_line = crlf

[*.{cmd,iss}]
end_of_line = crlf
