<Window x:Class="CodexDashboard.HudWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex HUD" Width="240" MinWidth="190" MaxWidth="300" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#202020" FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" Topmost="True">
 <Border CornerRadius="9" Background="#FAFAFA" BorderBrush="#D5D5D5" BorderThickness="1" Padding="10,5,10,6"><StackPanel>
   <DockPanel MouseLeftButtonDown="DragHeader" Background="Transparent" Cursor="SizeAll" Margin="0,0,0,4"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="⠿" Style="{StaticResource HudButton}" Click="MiniClicked" ToolTip="超 mini：只显示托盘圆点"/><Button Content="⋯" Style="{StaticResource HudButton}" Click="SettingsClicked" ToolTip="设置"/></StackPanel><TextBlock Text="Codex" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#555555"/></DockPanel>
   <ItemsControl ItemsSource="{Binding HudTasks}"><ItemsControl.ItemTemplate><DataTemplate><Grid Height="26" Background="Transparent" MouseLeftButtonDown="TaskClicked" Cursor="Hand" ToolTip="{Binding HudTip}"><Grid.ColumnDefinitions><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><Ellipse Width="7" Height="7" Fill="{Binding Color}" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="{Binding Project}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding ShortAge}" FontSize="10" Foreground="#888888" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock x:Name="EmptyHint" Text="最近没有任务" Foreground="#777777" FontSize="11" Margin="0,5"/>
   <DockPanel Margin="0,4,0,0"><Button DockPanel.Dock="Right" Content="↗" Style="{StaticResource HudButton}" Click="DashboardClicked" ToolTip="打开监控台"/><TextBlock Text="{Binding HudSummary}" Foreground="#777777" FontSize="10" VerticalAlignment="Center"/></DockPanel>
  </StackPanel></Border>
</Window>
