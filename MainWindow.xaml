<Window x:Class="CodexDashboard.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource ShellWindow}" ThemeMode="Light" Title="Codex Dashboard" Width="1280" Height="820" MinWidth="960" MinHeight="620" WindowStartupLocation="CenterScreen">
 <Grid Background="{StaticResource Bg}" ColumnDefinitions="218,*">
  <DockPanel Margin="14,24,10,18">
   <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,30"><Border Background="#E5F1FB" CornerRadius="6" Width="27" Height="27"><TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Codex Dashboard" FontWeight="SemiBold" FontSize="13" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="10,12,0,0"><TextBlock Text="连接" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,9"/><ItemsControl ItemsSource="{Binding Hosts}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,6" ToolTip="{Binding Detail}"><Ellipse Width="6" Height="6" Fill="{Binding Color}" Margin="0,0,9,0"/><TextBlock Text="{Binding Name}" FontSize="12"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="只读监控" FontSize="11" Foreground="#888888" Margin="0,14,0,0"/></StackPanel>
   <DockPanel><TextBlock DockPanel.Dock="Top" Text="项目" FontSize="12" Foreground="{StaticResource Muted}" Margin="10,0,0,10"/><ListBox x:Name="ProjectsList" ItemsSource="{Binding Projects}" SelectionChanged="ProjectChanged" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource NavItem}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Label}" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#777777" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
  </DockPanel>
  <Grid Grid.Column="1" Margin="20,24,28,16" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
   <DockPanel Margin="0,0,0,23"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="HUD" Click="ShowHud" Margin="0,0,8,0" Padding="13,7"/><Button Content="网页监控" Click="OpenWebClicked" Margin="0,0,8,0" Padding="13,7" ToolTip="{Binding WebStatus}"/><Button Click="OpenSettings" Padding="10,7" ToolTip="设置"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons"/></Button></StackPanel><StackPanel><TextBlock Text="工作区" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><TextBlock Text="任务概览" FontSize="28" FontWeight="SemiBold"/></StackPanel></DockPanel>
   <DockPanel Grid.Row="1" Margin="0,0,0,18"><TextBlock DockPanel.Dock="Right" Text="{Binding HostCountLabel,StringFormat={}{0} 台机器可读取}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal">
    <Ellipse Fill="#10893E" Width="8" Height="8" Margin="0,0,8,0"/><TextBlock Text="运行中" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Text="{Binding ActiveCount}" FontSize="21" FontWeight="SemiBold" Margin="10,0,27,0"/>
    <Ellipse Fill="#C27C00" Width="8" Height="8" Margin="0,0,8,0"/><TextBlock Text="需要关注" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Text="{Binding AttentionCount}" FontSize="21" FontWeight="SemiBold" Margin="10,0,27,0"/>
    <Ellipse Fill="#0078D4" Width="8" Height="8" Margin="0,0,8,0"/><TextBlock Text="今日结束" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Text="{Binding CompletedCount}" FontSize="21" FontWeight="SemiBold" Margin="10,0,0,0"/>
   </StackPanel></DockPanel>
   <Border Grid.Row="2" Background="#EAF2F9" BorderBrush="#DCE6EF" BorderThickness="1" CornerRadius="5" Padding="11,8" Margin="0,0,0,16"><DockPanel><TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" Foreground="#456479" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="依据会话记录显示状态。长时间无更新会标为待确认；本轮结束不等于项目完成。" FontSize="12" Foreground="#456479" TextWrapping="Wrap"/></DockPanel></Border>
   <Grid Grid.Row="3" Margin="0,0,0,16" ColumnDefinitions="*,130,132,45">
    <Grid Margin="0,0,10,0"><TextBox x:Name="SearchBox" TextChanged="SearchChanged" Padding="30,8,10,8" ToolTip="搜索项目、任务或进展"/><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="#666666" FontSize="12" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0"/><TextBlock Text="搜索项目、任务或进展" IsHitTestVisible="False" FontSize="13" VerticalAlignment="Center" Margin="31,0,0,0" Foreground="#777777"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=SearchBox,Path=Text}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <ComboBox x:Name="HostBox" Grid.Column="1" ItemsSource="{Binding HostNames}" SelectionChanged="HostChanged" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
    <ComboBox x:Name="StatusBox" Grid.Column="2" SelectionChanged="StatusChanged" SelectedIndex="0" Margin="0,0,10,0" VerticalContentAlignment="Center"><ComboBoxItem Content="最近 7 天"/><ComboBoxItem Content="全部任务"/><ComboBoxItem Content="运行中"/><ComboBoxItem Content="需要关注"/><ComboBoxItem Content="本轮结束"/><ComboBoxItem Content="状态待确认"/></ComboBox>
    <Button Grid.Column="3" Click="RefreshClicked" ToolTip="刷新"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons"/></Button>
   </Grid>
   <Grid Grid.Row="4" ColumnDefinitions="1.08*,20,*">
    <Grid><ListBox x:Name="TasksList" ItemsSource="{Binding VisibleTasks}" SelectionChanged="TaskChanged" ItemContainerStyle="{StaticResource TaskItem}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0"><Ellipse Width="6" Height="6" Fill="{Binding Color}" Margin="0,0,6,0"/><TextBlock Text="{Binding ShortStatus}" FontSize="12"/></StackPanel><TextBlock Text="{Binding HostProject}" FontSize="12" Foreground="#666666" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,10,0,8" TextWrapping="Wrap" MaxHeight="44"/><TextBlock Text="{Binding Preview}" Foreground="#666666" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" LineHeight="18" ToolTip="{Binding OverviewText}"/><TextBlock Text="{Binding Age}" Foreground="#888888" FontSize="11" Margin="0,10,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="EmptyState" Text="没有符合条件的任务" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource Muted}"/></Grid>
    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="23"><Grid>
     <TextBlock x:Name="SelectHint" Text="选择任务查看进展" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
     <Grid x:Name="Detail" DataContext="{Binding SelectedTask}" RowDefinitions="Auto,Auto,*">
      <StackPanel><TextBlock Text="{Binding HostProject}" FontSize="12" Foreground="#666666"/><TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,16"/></StackPanel>
      <DockPanel Grid.Row="1" Margin="0,0,0,21"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{Binding Color}" Margin="0,0,7,0"/><TextBlock Text="{Binding StatusLabel}" FontSize="12"/></StackPanel><TextBlock Text="{Binding Duration}" HorizontalAlignment="Right" FontSize="12" Foreground="#777777"/></DockPanel>
      <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
       <TabItem Header="进展"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,18,8,0"><StackPanel><Border Background="#F1F7FC" BorderBrush="#E0EBF5" BorderThickness="1" CornerRadius="6" Padding="13"><StackPanel><TextBlock Text="一句话概览" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="OverviewTextBlock" Text="{Binding OverviewText}" TextWrapping="Wrap" LineHeight="23" FontSize="14"/><TextBlock Text="{Binding OverviewSource}" Foreground="#777777" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border><Expander Header="最近回复原文" Margin="0,16,0,0"><TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" LineHeight="24" Margin="0,10,0,0"/></Expander><TextBlock Text="进展时间线" Style="{StaticResource SectionTitle}" Margin="0,28,0,14"/><ItemsControl ItemsSource="{Binding Timeline}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E5E5E5" BorderThickness="2,0,0,0" Padding="12,0,0,17" Margin="2,0,0,0"><StackPanel><TextBlock Text="{Binding Clock}" Foreground="#888888" FontSize="11"/><TextBlock Text="{Binding Text}" Margin="0,5,0,0" FontSize="13" TextWrapping="Wrap" LineHeight="21"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></TabItem>
       <TabItem Header="计划"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,18,8,0"><StackPanel><TextBlock Text="{Binding PlanLabel}" Style="{StaticResource SectionTitle}"/><ProgressBar Value="{Binding PlanPercent,Mode=OneWay}" Maximum="100" Height="4"><ProgressBar.Style><Style TargetType="ProgressBar"><Style.Triggers><DataTrigger Binding="{Binding Plan.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><ItemsControl ItemsSource="{Binding Plan}" Margin="0,18,0,0"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,7"><TextBlock Text="{Binding Mark}" Foreground="#10893E" Margin="0,0,9,0"/><TextBlock Text="{Binding Step}" TextWrapping="Wrap"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></TabItem>
       <TabItem Header="信息"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,18,8,0"><StackPanel><TextBlock Text="来源" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding DataNote}" Style="{StaticResource MutedText}" FontSize="12"/><TextBlock Text="工作目录" Style="{StaticResource SectionTitle}" Margin="0,25,0,10"/><TextBlock Text="{Binding Cwd}" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="模型" Style="{StaticResource SectionTitle}" Margin="0,25,0,10"/><TextBlock Text="{Binding Model}" FontSize="12"/></StackPanel></ScrollViewer></TabItem>
      </TabControl>
     </Grid>
    </Grid></Border>
   </Grid>
   <DockPanel Grid.Row="5" Margin="0,14,0,0"><TextBlock Text="{Binding Footer}" FontSize="11" Foreground="#888888"/><TextBlock Text="关闭窗口后继续在托盘运行" HorizontalAlignment="Right" FontSize="11" Foreground="#888888"/></DockPanel>
  </Grid>
 </Grid>
</Window>
