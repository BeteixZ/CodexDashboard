<Window x:Class="CodexDashboard.AssistantHealthWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="运行诊断" Width="760" Height="720" MinWidth="560" MinHeight="480"
 Style="{StaticResource ShellWindow}" ThemeMode="Light" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="26">
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
    <Button x:Name="ExportButton" Content="导出诊断摘要…" Click="ExportClicked" IsEnabled="False" Margin="0,0,8,0"/>
    <Button x:Name="RefreshButton" Content="刷新状态" Click="RefreshClicked"/>
   </StackPanel>
   <StackPanel>
    <TextBlock Text="运行诊断" FontSize="25" FontWeight="SemiBold"/>
    <TextBlock x:Name="ReadAtText" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,8,18,0"/>
   </StackPanel>
  </DockPanel>
  <TextBlock x:Name="ResultText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,12,0,0"
    Text="只查看当前状态；刷新不会发送消息、调用模型或操作 Codex。"/>
  <ScrollViewer x:Name="DiagnosticScroll" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <TextBlock Text="连接与问答" FontSize="17" FontWeight="SemiBold" Margin="0,8"/>
    <TextBlock x:Name="ConnectionText" TextWrapping="Wrap" Margin="0,0,0,20"/>
    <TextBlock Text="对话与执行记录" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock x:Name="RecordsText" TextWrapping="Wrap" Margin="0,0,0,20"/>
    <TextBlock Text="任务额度" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock x:Name="ConcurrencyText" TextWrapping="Wrap" Margin="0,0,0,20"/>
    <TextBlock Text="任务数据" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock x:Name="SourcesText" TextWrapping="Wrap" Margin="0,0,0,20"/>
    <Expander x:Name="DetailsExpander" Header="本机诊断详情" IsExpanded="False" Margin="0,0,0,12">
     <TextBox x:Name="DetailsBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
       Padding="10" Margin="0,12,0,0" BorderThickness="0"/>
    </Expander>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
