<Window x:Class="CodexDashboard.AssistantMemoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CodexDashboard" Title="AI 规则与长期记忆" Style="{StaticResource ShellWindow}" ThemeMode="Light" Width="820" Height="760" MinWidth="660" MinHeight="620" WindowStartupLocation="CenterOwner" ShowInTaskbar="True">
 <Window.Resources><local:ProjectMemoryScopeConverter x:Key="ProjectMemoryScope"/></Window.Resources>
 <DockPanel Margin="24">
  <Button DockPanel.Dock="Bottom" Content="完成" Click="CloseClicked" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="24,8"/>
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="规则与长期记忆" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="按当前 ChatGPT 账户和绑定微信用户分别保存。重启或切换模型后保留；“新对话”只清临时对话。" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,8,0,10"/>
   <CheckBox x:Name="UseMemoryBox" Content="在问答、进展解读和完成摘要中使用规则与长期记忆" Click="EnabledChanged"/>
   <CheckBox x:Name="AutoMemoryBox" Content="从日常微信对话自动记住长期偏好" Click="AutoMemoryChanged" Margin="0,8,0,0"/>
   <TextBlock Text="规则和记忆随回答请求发送给所选模型，使用订阅额度。自动提取在当前对话流程中处理，工具执行后可能再次生成回答；只保存明确的长期偏好。手动管理和来源查询在本机处理。记忆不能改变任务权限。" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,12"/>
  </StackPanel>
  <TabControl x:Name="EditorTabs">
   <TabItem Header="AGENTS.md 规则">
    <DockPanel Margin="12">
     <TextBlock DockPanel.Dock="Top" Text="设置语言、报告格式和回答偏好。保存后对下一次回答生效，最多 8000 字符。" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <WrapPanel><Button x:Name="SaveRulesButton" Content="保存规则" Click="SaveRulesClicked" Margin="0,0,8,8"/><Button x:Name="ReloadRulesButton" Content="重新读取文件" Click="ReloadRulesClicked" Margin="0,0,8,8"/><Button Content="打开数据文件夹" Click="OpenFolderClicked" Margin="0,0,0,8"/></WrapPanel>
      <TextBlock x:Name="RulesLocation" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="11"/>
      <TextBlock x:Name="RulesStatus" TextWrapping="Wrap" Margin="0,6,0,0"/>
     </StackPanel>
     <TextBox x:Name="RulesBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas, Microsoft YaHei UI" Padding="10"/>
    </DockPanel>
   </TabItem>
   <TabItem x:Name="MemoryTab" Header="长期记忆">
    <ScrollViewer x:Name="MemoryScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,110,Auto,Auto">
     <StackPanel>
      <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="搜索" Click="SearchMemoriesClicked" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="全部" Click="ClearMemorySearchClicked" Margin="8,0,0,0"/><TextBox x:Name="MemorySearchBox" ToolTip="搜索正文、完整编号、来源或项目范围" KeyDown="MemorySearchKeyDown"/></DockPanel>
      <TextBlock x:Name="MemoryCountText" TextWrapping="Wrap" Margin="0,0,0,8"/>
     </StackPanel>
     <ListBox x:Name="MemoryList" Grid.Row="1" MinHeight="90" MaxHeight="180" SelectionChanged="MemorySelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,5"><TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="11" Foreground="#61656D"/><TextBlock Text="{Binding SourceSummary}" TextWrapping="Wrap" FontSize="11" Foreground="#61656D"/><TextBlock Text="{Binding Converter={StaticResource ProjectMemoryScope}}" TextWrapping="Wrap" FontSize="11" Foreground="#61656D"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel Grid.Row="2" Margin="0,10,0,6">
      <TextBlock Text="摘要需选择 2–8 条有效记忆，由你整理确认，不代表助手核实过的工作经历；来源变化后停用。" TextWrapping="Wrap"/>
      <TextBlock Text="项目记忆需先明确选择当前任务，并在专用窗口核对项目范围；不会作为个人通用记忆或摘要来源。" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,0"/>
      <TextBlock x:Name="MemorySourceSummary" Text="选择一条记忆，可查看它的来源。" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,0"/>
     </StackPanel>
     <TextBox x:Name="MemoryText" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10"/>
     <WrapPanel Grid.Row="4" Margin="0,10,0,0"><Button x:Name="AddMemoryButton" Content="新增记忆" Click="AddClicked" Margin="0,0,8,8"/><Button x:Name="EpisodeMemoryButton" Content="情景摘要…" Click="EpisodeClicked" Margin="0,0,8,8"/><Button x:Name="ProjectEpisodeMemoryButton" Content="项目情景摘要…" Click="ProjectEpisodeClicked" Margin="0,0,8,8"/><Button x:Name="SummaryMemoryButton" Content="整理摘要…" Click="SummaryClicked" Margin="0,0,8,8"/><Button x:Name="ProjectMemoryButton" Content="项目记忆…" Click="ProjectClicked" Margin="0,0,8,8"/><Button x:Name="UpdateMemoryButton" Content="保存所选修改" Click="UpdateClicked" Margin="0,0,8,8"/><Button x:Name="DeleteMemoryButton" Content="删除所选" Click="DeleteClicked" Margin="0,0,8,8"/><Button x:Name="SourceMemoryButton" Content="查看来源…" Click="SourceClicked" Margin="0,0,8,8"/><Button x:Name="ReloadMemoryButton" Content="刷新列表" Click="ReloadMemoryClicked" Margin="0,0,0,8"/></WrapPanel>
     <TextBlock x:Name="MemoryStatus" Grid.Row="5" TextWrapping="Wrap"/>
    </Grid>
    </ScrollViewer>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
