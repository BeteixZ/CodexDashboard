<Window x:Class="CodexDashboard.AssistantWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Codex 助手" Width="620" Height="520" MinWidth="520" MinHeight="430"
 Style="{StaticResource ShellWindow}" ThemeMode="Light" WindowStartupLocation="CenterScreen">
 <ScrollViewer Background="{StaticResource Bg}" Padding="32" VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock Text="个人助手" FontSize="28" FontWeight="SemiBold"/>
  <TextBlock Text="在微信接着聊，随时查看和安排 Codex 工作。" Style="{StaticResource MutedText}" Margin="0,10,0,25"/>
  <TextBlock x:Name="WeChatText" TextWrapping="Wrap" Margin="0,8"/>
  <TextBlock x:Name="ModelText" TextWrapping="Wrap" Margin="0,8"/>
  <TextBlock x:Name="TasksText" TextWrapping="Wrap" Margin="0,8"/>
  <TextBlock x:Name="ConnectionText" Style="{StaticResource MutedText}" Margin="0,8,0,20"/>
  <WrapPanel>
   <Button Content="微信与数据源…" Click="SettingsClicked" Margin="0,0,10,10"/>
   <Button Content="模型与记忆…" Click="ModelClicked" Margin="0,0,10,10"/>
   <Button x:Name="ArtifactButton" Content="准备文件…" Click="ArtifactClicked" Margin="0,0,10,10" Visibility="Collapsed"/>
   <Button x:Name="PreparedFilesButton" Content="已准备文件…" Click="PreparedFilesClicked" Margin="0,0,10,10" Visibility="Collapsed"/>
   <Button Content="工作与记录…" Click="WorkClicked" Margin="0,0,10,10"/>
   <Button x:Name="HealthButton" Content="运行诊断…" Click="HealthClicked" Margin="0,0,10,10"/>
   <Button Content="迁移检查…" Click="MigrationClicked" Margin="0,0,10,10"/>
   <Button Content="隐藏到托盘" Click="HideClicked" Margin="0,0,10,10"/>
  </WrapPanel>
  <TextBlock x:Name="FooterText" Text="关闭此窗口后继续运行。可从托盘退出助手。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8"/>
 </StackPanel></ScrollViewer>
</Window>
