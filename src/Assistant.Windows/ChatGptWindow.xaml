<Window x:Class="CodexDashboard.ChatGptWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ChatGPT · 微信 AI 助手" Style="{StaticResource ShellWindow}" ThemeMode="Light" Width="660" Height="700" MinWidth="580" MinHeight="620" WindowStartupLocation="CenterOwner" ShowInTaskbar="True">
 <DockPanel Margin="28">
  <Button DockPanel.Dock="Bottom" Content="完成" Click="CloseClicked" HorizontalAlignment="Right" Padding="24,8" Margin="0,18,0,0"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"><StackPanel>
   <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10"><TextBlock Text="在微信使用 ChatGPT" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="规则与长期记忆…" Click="MemoryClicked" Padding="12,7"/></Grid>
   <TextBlock Text="使用你的 ChatGPT 订阅额度生成回答。首次登录需在 OpenAI 页面同意授权，可用模型和额度由账户决定。" Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,0,18"/>
   <TextBlock Text="ChatGPT 账户" Style="{StaticResource SectionTitle}"/>
   <ComboBox x:Name="AccountBox" DisplayMemberPath="Label" SelectionChanged="AccountChanged" Margin="0,10,0,10" Padding="8,6"/>
   <WrapPanel><Button x:Name="ConnectButton" Content="Continue with ChatGPT" Click="ConnectClicked" Background="#171717" Foreground="White" Padding="14,8" Margin="0,0,8,8"/><Button x:Name="AddButton" Content="添加账户…" Click="AddClicked" Margin="0,0,8,8"/><Button x:Name="SignOutButton" Content="退出所选账户" Click="SignOutClicked" Margin="0,0,0,8"/></WrapPanel>
   <Button x:Name="CancelLoginButton" Content="取消本次登录" Click="CancelLoginClicked" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,0,0,8"/>
   <TextBlock x:Name="ConnectionText" TextWrapping="Wrap" Margin="0,4,0,14" FontSize="13"/>
   <TextBlock Text="模型 · 使用 ChatGPT 订阅额度" Style="{StaticResource SectionTitle}"/>
   <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,15"><ComboBox x:Name="ModelBox" DisplayMemberPath="DisplayName" SelectionChanged="ModelChanged" Padding="8,6"/><Button x:Name="RefreshButton" Grid.Column="1" Content="刷新模型" Click="RefreshClicked" Margin="10,0,0,0"/></Grid>
   <CheckBox x:Name="EnabledBox" Content="在微信启用 AI 问答" Click="OptionsChanged" Margin="0,6"/>
   <CheckBox x:Name="ContextBox" Content="回答时提供相关任务状态与公开最终报告" Click="OptionsChanged" Margin="0,6"/>
   <CheckBox x:Name="CompletionSummaryBox" Content="任务完成后，用 ChatGPT 自动生成微信摘要" Click="OptionsChanged" Margin="0,6"/>
   <CheckBox x:Name="TaskControlBox" Content="允许微信绑定用户用自然语言接续原 Codex 任务" Click="OptionsChanged" Margin="0,6"/>
   <TextBlock Text="支持本机与已配置 SSH 服务器。查看已有进展直接读取目标公开记录，运行中也可查，不向任务发指令；追加工作原文投递，忙时排队。目标不明确时选择目标任务，无需另选聊天代问。远程需原 Codex 服务运行且登录有效，审批仍在 Codex 中处理。待发指令加密保存在本机，24 小时后失效。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,8"/>
   <TextBlock Text="自动摘要会将对应轮次的公开最终报告发送给 OpenAI，使用订阅额度，按你的人设自然汇报结果和仍未解决的问题。生成失败时直接说明原因。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,8"/>
   <TextBlock Text="开启任务上下文后，相关状态、任务标题和报告会随问题发送给 OpenAI。状态、报告等固定指令继续直接查询。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,7,0,16"/>
   <TextBlock Text="AGENTS.md 设置回答规则；在微信发送“记住：…”“查看记忆”“修改记忆 编号 新内容”“删除记忆 编号”。长期记忆重启后保留，增删改查不调用模型。" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>
   <WrapPanel><Button x:Name="TestButton" Content="测试实际生成" Click="TestClicked" Margin="0,0,8,8"/><Button Content="管理 ChatGPT 用量" Click="UsageClicked" Margin="0,0,0,8"/></WrapPanel>
   <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontSize="13" Margin="0,6,0,16"/>
   <Border Background="#F3F5F7" CornerRadius="8" Padding="14"><TextBlock Text="微信示例：今天完成了哪些任务？&#x0a;继续 Alpha 的测试，把失败项修好。&#x0a;查看 scipy 那个任务的进展。&#x0a;任务列表 · 工作列表 · 取消接续 · AI状态&#x0a;&#x0a;对话和操作记录保存在本机，并由当前 Windows 用户加密。电脑与助手需要保持运行；监控台可以单独关闭。" TextWrapping="Wrap" FontSize="12"/></Border>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
