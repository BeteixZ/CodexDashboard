<Window x:Class="CodexDashboard.WeChatBindingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="连接微信 ClawBot" Style="{StaticResource ShellWindow}" ThemeMode="Light" Width="460" Height="640" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Margin="28" RowDefinitions="Auto,Auto,*,Auto,Auto">
  <TextBlock Text="连接微信 ClawBot" FontSize="24" FontWeight="SemiBold"/>
  <TextBlock Grid.Row="1" Text="使用你自己的微信扫一扫，并在手机上确认。连接后请给 ClawBot 发送“帮助”激活查询。" Style="{StaticResource MutedText}" Margin="0,14,0,8"/>
  <Border Grid.Row="2" Background="White" Margin="0,8" Padding="8" HorizontalAlignment="Center" VerticalAlignment="Center"><Image x:Name="QrImage" Width="260" Height="260" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Border>
  <StackPanel Grid.Row="3">
   <TextBlock x:Name="LoginStatus" Text="正在获取二维码…" TextWrapping="Wrap" Margin="0,8"/>
   <StackPanel x:Name="VerifyPanel" Visibility="Collapsed">
    <TextBlock Text="输入手机微信显示的数字" Margin="0,6"/>
    <Grid ColumnDefinitions="*,Auto"><PasswordBox x:Name="VerifyBox" Padding="8" MaxLength="12"/><Button Grid.Column="1" Content="继续验证" Click="VerifyClicked" Margin="10,0,0,0"/></Grid>
   </StackPanel>
  </StackPanel>
  <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,20,0,0"><Button x:Name="RetryButton" Content="重新获取二维码" Click="RetryClicked" IsEnabled="False" Margin="0,0,10,0"/><Button Content="取消" Click="CancelClicked"/></WrapPanel>
 </Grid>
</Window>
